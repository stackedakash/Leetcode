import java.util.*;

class Solution {
    private Map<Integer, List<Integer>> hm = new HashMap<>();
    private Set<Integer> visit = new HashSet<>();

    public int[] findRedundantConnection(int[][] edges) {
        int n = edges.length;
        
        // Initialize adjacency list for nodes 1 to n
        for (int i = 1; i <= n; i++) {chrome-extension://jfiihjeimjpkpoaekpdpllpaeichkiod/eraser.png$0
            hm.put(i, new ArrayList<>());
        }

        for (int[] edge : edges) {
            int u = edge[0];
            int v = edge[1];

            // Reset visited set for every edge check
            visit.clear();

            // If a path already exists between u and v, adding this edge creates a cycle
            if (dfs(u, v, -1)) {
                return edge;
            }

            // Otherwise, add the edge to the undirected graph
            hm.get(u).add(v);
            hm.get(v).add(u);
        }

        return new int[0];
    }

    // Returns true if there is a path from 'curr' to 'target'
    private boolean dfs(int curr, int target, int parent) {
        if (curr == target) {
            return true;
        }

        visit.add(curr);

        for (int neighbor : hm.get(curr)) {
            if (neighbor == parent) {
                continue; // Skip going back to the parent node
            }
            if (!visit.contains(neighbor)) {
                if (dfs(neighbor, target, curr)) {
                    return true;
                }
            }
        }

        return false;
    }
}
