import java.util.HashMap;
import java.util.Map;

public class Solution {
    public int findTargetSumWays(int[] nums, int target) {
        // Map to cache results: Key = "index,total", Value = number of ways
        Map<String, Integer> memo = new HashMap<>();
        return backtrack(0, 0, nums, target, memo);
    }

    private int backtrack(int index, int total, int[] nums, int target, Map<String, Integer> memo) {
        // Base Case: Reached the end of the array
        if (index == nums.length) {
            return total == target ? 1 : 0;
        }

        // Create a unique key for the current state
        String key = index + "," + total;

        // If we have already solved this subproblem, return the stored result
        if (memo.containsKey(key)) {
            return memo.get(key);
        }

        // Explore adding and subtracting current element
        int add = backtrack(index + 1, total + nums[index], nums, target, memo);
        int subtract = backtrack(index + 1, total - nums[index], nums, target, memo);

        // Store result in memo map and return
        int result = add + subtract;
        memo.put(key, result);

        return result;
    }
}
