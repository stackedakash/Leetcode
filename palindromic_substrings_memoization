import java.util.Arrays;

class Solution {
    public int countSubstrings(String s) {
        if (s == null || s.length() == 0) return 0;

        int n = s.length();
        // memo[i][j]: 1 = palindrome, 0 = not palindrome, -1 = uncomputed
        int[][] memo = new int[n][n];
        for (int[] row : memo) {
            Arrays.fill(row, -1);
        }

        int count = 0;
        // Count all valid pairs (i, j) where i <= j
        for (int i = 0; i < n; i++) {
            for (int j = i; j < n; j++) {
                if (isPalindrome(s, i, j, memo) == 1) {
                    count++;
                }
            }
        }

        return count;
    }

    private int isPalindrome(String s, int i, int j, int[][] memo) {
        // Base case 1: Single character or empty substring
        if (i >= j) return 1;

        // Return memoized result if already computed
        if (memo[i][j] != -1) return memo[i][j];

        // Recursive case
        if (s.charAt(i) == s.charAt(j)) {
            memo[i][j] = isPalindrome(s, i + 1, j - 1, memo);
        } else {
            memo[i][j] = 0;
        }

        return memo[i][j];
    }
}


//CODE END

Complexity Analysis
Time Complexity: O(N^2) — There are O(N^2) unique subproblems (substring pairs (i, j)).
Each state is solved at most once in O(1) constant time.
Space Complexity: O(N^2) — Required for the 2D memoization matrix, plus O(N) auxiliary stack space for 
the maximum recursion depth.
