import java.util.Arrays;

class Solution {
    public int maxCoins(int[] nums) {
        int n = nums.length;
        
        // Add boundary 1s to simplify edge cases
        int[] paddedNums = new int[n + 2];
        paddedNums[0] = 1;
        paddedNums[paddedNums.length - 1] = 1;
        for (int i = 0; i < n; i++) {
            paddedNums[i + 1] = nums[i];
        }

        // Memoization table: memo[left][right] stores max coins for range (left, right)
        int[][] memo = new int[paddedNums.length][paddedNums.length];
        for (int[] row : memo) {
            Arrays.fill(row, -1);
        }

        // Solve for the range (0, paddedNums.length - 1)
        return solve(0, paddedNums.length - 1, paddedNums, memo);
    }

    private int solve(int left, int right, int[] nums, int[][] memo) {
        // Base case: no balloons between left and right
        if (left + 1 >= right) {
            return 0;
        }
        // Return memoized result if available
        if (memo[left][right] != -1) {
            return memo[left][right];
        }
        int maxCoins = 0;
        // Try bursting every balloon k in the range (left, right) LAST
        for (int k = left + 1; k < right; k++) {
            int coinsFromKLast = nums[left] * nums[k] * nums[right];
            int leftSubproblem = solve(left, k, nums, memo);
            int rightSubproblem = solve(k, right, nums, memo);

            int totalCoins = coinsFromKLast + leftSubproblem + rightSubproblem;
            maxCoins = Math.max(maxCoins, totalCoins);
        }
        return memo[left][right] = maxCoins;
    }
}
//CODE END
Complexity Analysis
Time Complexity: O(N^3) There are O(N^2) possible ranges (left, right).For each range, we loop O(N) times to try every potential last balloon k

Space Complexity: O(N^2) — For the 2D memo array of size (N+2) * (N+2) plus the recursive call stack depth bounded by O(N).

