class Solution {
    private Integer[][] memo;

    public int maxProfit(int[] prices) {
        memo = new Integer[prices.length][3];
        return dfs(prices, 0, 0);
    }

    private int dfs(int[] prices, int i, int state) {
        if (i >= prices.length)
            return 0;

        // Memo check on fixed 3 * N states
        if (memo[i][state] != null) {

            return memo[i][state];
        }
        if (state == 0) { // Ready to Buy
            int buy = -prices[i] + dfs(prices, i + 1, 1);
            int rest = dfs(prices, i + 1, 0);

            memo[i][state] = Math.max(buy, rest);

        } else if (state == 1) { // Holding Stock
            int sell = prices[i] + dfs(prices, i + 1, 2);
            int hold = dfs(prices, i + 1, 1);

            memo[i][state] = Math.max(sell, hold);

        } else {

            memo[i][state] = dfs(prices, i + 1, 0);

        }

        return memo[i][state];
    }
}






