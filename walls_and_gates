
class Solution {
    public void islandsAndTreasure(int[][] grid) {
        if (grid == null || grid.length == 0) return;

        int rows = grid.length;
        int cols = grid[0].length;
        Queue<int[]> queue = new LinkedList<>();

        // Step 1: Add all treasure chests (0s) to the queue
        for (int r = 0; r < rows; r++) {
            for (int c = 0; c < cols; c++) {
                if (grid[r][c] == 0) {
                    queue.offer(new int[]{r, c});
                }
            }
        }
        // Direction vectors for moving Up, Right, Down, Left
        int[][] directions = {{-1, 0}, {1, 0}, {0, -1}, {0, 1}};
        // Step 2: Multi-source BFS
        while (!queue.isEmpty()) {
            int[] cell = queue.poll();
            int row = cell[0];
            int col = cell[1];

            for (int[] dir : directions) {
                int r = row + dir[0];
                int c = col + dir[1];

                // Check bounds and if the neighbor is an unvisited land cell (INF)
                if (r >= 0 && r < rows && c >= 0 && c < cols && grid[r][c] == Integer.MAX_VALUE) {
                    // Update distance to 1 + distance of current cell
                    grid[r][c] = grid[row][col] + 1;
                    queue.offer(new int[]{r, c});
                }
            }
        }
    }
}
CODE END
Time complexity: O(m∗n)
Space complexity: O(m∗n)
