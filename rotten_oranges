import java.util.LinkedList;
import java.util.Queue;
class Solution {
    public int orangesRotting(int[][] grid) {
        if (grid == null || grid.length == 0) return 0;
        
        int rows = grid.length;
        int cols = grid[0].length;
        
        Queue<int[]> queue = new LinkedList<>();
        int freshCount = 0;
        
        // Step 1: Collect initial rotten oranges and count fresh ones
        for (int r = 0; r < rows; r++) {
            for (int c = 0; c < cols; c++) {
                if (grid[r][c] == 2) {
                    queue.offer(new int[]{r, c});
                } else if (grid[r][c] == 1) {
                    freshCount++;
                }
            }
        }
        // If there are no fresh oranges to rot from the start
        if (freshCount == 0) return 0;
        
        int minutes = 0;
        int[][] directions = {{-1, 0}, {1, 0}, {0, -1}, {0, 1}};
    
        // Step 2: Multi-source BFS
        while (!queue.isEmpty() && freshCount > 0) {
            int size = queue.size();
            boolean rottedInThisMinute = false;
            
            for (int i = 0; i < size; i++) {
                int[] curr = queue.poll();
                int r = curr[0];
                int c = curr[1];
                
                for (int[] dir : directions) {
                    int nr = r + dir[0];
                    int nc = c + dir[1];
                    
                    if (nr >= 0 && nr < rows && nc >= 0 && nc < cols && grid[nr][nc] == 1) {
                        grid[nr][nc] = 2; // Mark as rotten
                        freshCount--;
                        queue.offer(new int[]{nr, nc});
                        rottedInThisMinute = true; // Record that rot successfully spread
                    }
                }
            }
            
            // Increment minutes only if at least one fresh orange rotted in this cycle
            if (rottedInThisMinute) {
                minutes++;
            }
        }
    
        // Step 3: Check if all fresh oranges were reachable
        return freshCount == 0 ? minutes : -1;
    }
}
CODE END

Time complexity:
O(m⋅n)
where m and n are the grid's dimensions, since every cell is enqueued and processed at most once, and each processing step does constant work (checking up to 4 neighbors).

Space complexity:
O(m⋅n)
for the queue, which in the worst case can hold a significant fraction of the grid's cells at once during the spread.
