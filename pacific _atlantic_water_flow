
class Solution {
    int dir[][] = { { 0, 1 }, { 0, -1 }, { 1, 0 }, { -1, 0 } };

    public List<List<Integer>> pacificAtlantic(int[][] matrix) {
        int r = matrix.length;
        int c = matrix[0].length;
        List<List<Integer>> result = new ArrayList<>();
        boolean[][] pacific = new boolean[r][c];
        boolean[][] atlantic = new boolean[r][c];
        if (matrix == null || matrix.length == 0 || matrix[0].length == 0)
            return result;

        for (int i = 0; i < c; i++) {
            dfs(matrix, 0, i, Integer.MIN_VALUE, atlantic);
            dfs(matrix, r - 1, i, Integer.MIN_VALUE, pacific);
        }

        for (int i = 0; i < r; i++) {
            dfs(matrix, i, 0, Integer.MIN_VALUE, atlantic);
            dfs(matrix, i, c - 1, Integer.MIN_VALUE, pacific);
        }
        for (int i = 0; i < r; i++) {
            for (int j = 0; j < c; j++) {
                if (atlantic[i][j] && pacific[i][j]) {
                    result.add(Arrays.asList(i, j));
                }
            }
        }
        return result;

    }

    void dfs(int[][] matrix, int i, int j, int prev, boolean[][] ocean) {
        if (i < 0 || j < 0 || i >= matrix.length || j >= matrix[0].length || matrix[i][j] < prev || ocean[i][j])
            return;
        ocean[i][j] = true;
        for (int[] di : dir) {
            dfs(matrix, i + di[0], j + di[1], matrix[i][j], ocean);
        }
    }
}
